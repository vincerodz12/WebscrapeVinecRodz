                doc.text(Difficulty Range: Easy to Hard, 105, 130, { align: 'center' });
 
                // Table of Contents
                doc.addPage();
                doc.setFontSize(18);
                doc.setTextColor(102, 126, 234);
                doc.text('Table of Contents', 20, 30);
 
                doc.setFontSize(11);
                doc.setTextColor(30, 41, 59);
                topics.forEach((topic, idx) => {
                    doc.text(${idx + 1}. ${topic.title} (${topic.difficulty}), 25, 50 + (idx * 7));
                });
 
                // Content Pages
                topics.forEach((topic, idx) => {
                    doc.addPage();
 
                    doc.setFontSize(16);
                    doc.setTextColor(102, 126, 234);
                    doc.text(${idx + 1}. ${topic.title}, 20, 30);
 
                    doc.setFontSize(11);
                    doc.setTextColor(30, 41, 59);
                    doc.text(Difficulty: ${topic.difficulty}, 20, 45);
                    doc.text(Source: GeeksforGeeks DBMS, 20, 53);
 
                    doc.line(20, 58, 190, 58);
 
                    let y = 70;
 
                    doc.setFontSize(12);
                    doc.setTextColor(102, 126, 234);
                    doc.text('Key Concepts:', 20, y);
                    y += 8;
 
                    doc.setFontSize(10);
                    doc.setTextColor(30, 41, 59);
                    const concepts = doc.splitTextToSize(topic.keyConcepts, 170);
                    doc.text(concepts, 20, y);
                    y += concepts.length * 6 + 10;
 
                    if (y > 250) {
                        doc.addPage();
                        y = 30;
                    }
 
                    doc.setFontSize(12);
                    doc.setTextColor(102, 126, 234);
                    doc.text('SQL Implementation:', 20, y);
                    y += 8;
 
                    doc.setFontSize(9);
                    doc.setTextColor(0, 0, 0);
                    const code = doc.splitTextToSize(topic.codeSnippet, 170);
                    doc.text(code, 20, y);
                    y += code.length * 5 + 10;
 
                    if (y > 250) {
                        doc.addPage();
                        y = 30;
                    }
 
                    doc.setFontSize(12);
                    doc.setTextColor(102, 126, 234);
                    doc.text('Complexity Analysis:', 20, y);
                    y += 8;
 
                    doc.setFontSize(10);
                    doc.setTextColor(30, 41, 59);
                    const complexity = doc.splitTextToSize(topic.complexityAnalysis, 170);
                    doc.text(complexity, 20, y);
                    y += complexity.length * 6 + 10;
 
                    if (y > 250) {
                        doc.addPage();
                        y = 30;
                    }
 
                    doc.setFontSize(12);
                    doc.setTextColor(102, 126, 234);
                    doc.text('References:', 20, y);
                    y += 8;
 
                    doc.setFontSize(8);
                    doc.setTextColor(100, 116, 139);
                    const refText = topic.references.map(url => {
                        const title = url.replace('https://www.geeksforgeeks.org/', '').replace(/-/g, ' ').split('/')[0];
                        return ${title}: ${url};
                    }).join('\n\n');
 
                    const refs = doc.splitTextToSize(refText, 170);
                    doc.text(refs, 20, y);
 
                    doc.setFontSize(8);
                    doc.setTextColor(156, 163, 175);
                    doc.text('Generated by [Student Name] · GeeksforGeeks Academic Scraper', 20, 280);
                    doc.text(Page ${idx + 3}, 180, 280);
                });
 
                doc.save('GeeksforGeeks_DBMS_Module.pdf');
            }
 
            // ============= FETCH FUNCTION =============
 
            function fetchGeeksforGeeksData() {
                const scrapeBtn = document.getElementById('scrapeBtn');
                const pdfBtn = document.getElementById('pdfBtn');
 
                scrapeBtn.disabled = true;
                scrapeBtn.innerHTML = '<i class="fas fa-spinner fa-pulse"></i> Loading DBMS Data...';
                updateStatus('info', '📡 Loading DBMS articles from GeeksforGeeks database...');
 
                setTimeout(() => {
                    try {
                        localStorage.setItem(STORAGE_KEY, JSON.stringify(GEEKSFORGEEKS_DBMS_ARTICLES));
                        renderTopics(GEEKSFORGEEKS_DBMS_ARTICLES);
                        pdfBtn.disabled = false;
                        document.getElementById('statPdf').textContent = 'Ready';
                        updateStatus('success', ✅ Successfully loaded ${GEEKSFORGEEKS_DBMS_ARTICLES.length} DBMS articles from GeeksforGeeks);
                    } catch (error) {
                        updateStatus('error', ❌ Error loading data: ${error.message});
                    } finally {
                        scrapeBtn.disabled = false;
                        scrapeBtn.innerHTML = '<i class="fas fa-cloud-download-alt"></i> Fetch DBMS Data from GeeksforGeeks';
                    }
                }, 1500);
            }
 
            // ============= EVENT LISTENERS =============
 
            document.getElementById('scrapeBtn').addEventListener('click', fetchGeeksforGeeksData);
            document.getElementById('pdfBtn').addEventListener('click', generatePDF);
            document.getElementById('clearBtn').addEventListener('click', clearCache);
 
            // Load cached data on page load
            window.addEventListener('load', () => {
                const cached = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
                if (cached && cached.length > 0) {
                    renderTopics(cached);
                    document.getElementById('pdfBtn').disabled = false;
                    document.getElementById('statPdf').textContent = 'Ready';
                    updateStatus('success', ✅ Loaded ${cached.length} DBMS topics from cache (from GeeksforGeeks));
                }
            });
        })();
    </script>
