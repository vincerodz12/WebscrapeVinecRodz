                        </div>
                    </div>
                `;
            }
 
            function clearCache() {
                if (confirm('Are you sure you want to clear all cached GeeksforGeeks DBMS data?')) {
                    localStorage.removeItem(STORAGE_KEY);
                    document.getElementById('topicList').innerHTML = '<p style="color: #94a3b8; text-align: center; padding: 2rem;"><i class="fas fa-database fa-2x"></i><br>Click fetch to load DBMS topics from GeeksforGeeks</p>';
                    document.getElementById('topicCount').textContent = '0/12';
                    document.getElementById('statTopics').textContent = '0';
                    document.getElementById('previewContent').innerHTML = '<p style="color: #94a3b8; text-align: center; padding: 2rem;"><i class="fas fa-hand-pointer fa-2x"></i><br>Select a topic to preview its content</p>';
                    document.getElementById('pdfBtn').disabled = true;
                    updateStatus('info', 'Cache cleared successfully. Click "Fetch DBMS Data" to load GeeksforGeeks content.');
                }
            }
 
            // ============= PDF GENERATION =============
 
            function generatePDF() {
                const topics = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
 
                if (topics.length === 0) {
                    alert('No data to generate PDF. Please fetch DBMS data first.');
                    return;
                }
 
                const { jsPDF } = window.jspdf;
                const doc = new jsPDF();
 
                // Cover Page
                doc.setFontSize(28);
                doc.setTextColor(102, 126, 234);
                doc.text('GeeksforGeeks', 105, 50, { align: 'center' });
 
                doc.setFontSize(22);
                doc.setTextColor(30, 41, 59);
                doc.text('DBMS Learning Module', 105, 75, { align: 'center' });
 
