            // ============= UI FUNCTIONS =============
 
            function updateStatus(type, message) {
                const statusBox = document.getElementById('statusBox');
                const icon = type === 'success' ? '✓' : type === 'error' ? '⚠' : 'ℹ';
                statusBox.innerHTML = <i class="fas fa-${type === 'success' ? 'check-circle' : type === 'error' ? 'exclamation-circle' : 'info-circle'}"></i> ${message};
                statusBox.style.borderLeftColor = type === 'success' ? '#10b981' : type === 'error' ? '#ef4444' : '#667eea';
            }
 
            function updateCacheInfo() {
                const data = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
                // Stats are handled in renderTopics
            }
 
            function renderTopics(topics) {
                const listEl = document.getElementById('topicList');
                const countEl = document.getElementById('topicCount');
                const statTopics = document.getElementById('statTopics');
 
                if (!topics || topics.length === 0) {
                    listEl.innerHTML = '<p style="color: #94a3b8; text-align: center; padding: 2rem;"><i class="fas fa-database fa-2x"></i><br>Click fetch to load DBMS topics from GeeksforGeeks</p>';
                    countEl.textContent = '0/12';
                    statTopics.textContent = '0';
                    return;
                }
 
                countEl.textContent = ${topics.length}/12;
                statTopics.textContent = topics.length;
 
                let html = '';
                topics.forEach((topic, index) => {
                    const difficultyClass = topic.difficulty.toLowerCase() === 'easy' ? 'difficulty-easy' :
                                           topic.difficulty.toLowerCase() === 'hard' ? 'difficulty-hard' : 
                                           'difficulty-medium';
 
                    html += `
                        <div class="topic-item" data-index="${index}">
                            <div class="topic-title">
                                <span>${topic.title}</span>
                                <span class="difficulty-badge ${difficultyClass}">${topic.difficulty}</span>
                            </div>
                            <div class="topic-description">
                                ${topic.keyConcepts.substring(0, 100)}...
                            </div>
                        </div>
                    `;
                });
 
                listEl.innerHTML = html;
 
                // Add click handlers
                document.querySelectorAll('.topic-item').forEach(item => {
                    item.addEventListener('click', () => {
                        document.querySelectorAll('.topic-item').forEach(el => el.classList.remove('selected'));
                        item.classList.add('selected');
                        const index = item.dataset.index;
                        showPreview(topics[index]);
                    });
                });
 
                // Auto-select first
                if (topics.length > 0) {
                    document.querySelector('.topic-item')?.classList.add('selected');
                    showPreview(topics[0]);
                }
            }
 
            function showPreview(topic) {
                const previewEl = document.getElementById('previewContent');
 
                const referenceLinks = topic.references.map(url => {
                    let title = url.replace('https://www.geeksforgeeks.org/', '');
                    title = title.replace(/-/g, ' ');
                    title = title.split('/')[0];
                    title = title.charAt(0).toUpperCase() + title.slice(1);
 
                    return `
                        <div class="reference-item">
                            <a href="${url}" target="_blank" rel="noopener noreferrer" class="reference-link">
                                <i class="fas fa-external-link-alt"></i> ${title}
                            </a>
                        </div>
                    `;
                }).join('');
 
                previewEl.innerHTML = `
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-tag"></i> Topic Title</div>
                        <div class="preview-value">${topic.title}</div>
                    </div>
 
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-chart-line"></i> Difficulty Level</div>
                        <div class="preview-value">
                            <span class="difficulty-badge ${topic.difficulty.toLowerCase() === 'easy' ? 'difficulty-easy' : topic.difficulty.toLowerCase() === 'hard' ? 'difficulty-hard' : 'difficulty-medium'}">
                                ${topic.difficulty}
                            </span>
                        </div>
                    </div>
 
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-brain"></i> Key Concepts</div>
                        <div class="preview-value">${topic.keyConcepts}</div>
                    </div>
 
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-code"></i> SQL Implementation</div>
                        <div class="code-block"><pre>${topic.codeSnippet.replace(/\n/g, '<br>')}</pre></div>
                    </div>
 
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-chart-simple"></i> Complexity Analysis</div>
                        <div class="preview-value">${topic.complexityAnalysis}</div>
                    </div>
 
                    <div class="preview-field">
                        <div class="preview-label"><i class="fas fa-link"></i> References (Click to open)</div>
                        <div class="preview-value">
